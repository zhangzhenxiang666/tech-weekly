{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangzhenxiang666.github.io/tech-weekly/schemas/issue-v1.schema.json",
  "title": "Tech Weekly issue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "column", "date", "title", "summary", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "column": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "coverage": {"type": "string", "minLength": 1, "maxLength": 300},
    "provenance": {"type": "string", "minLength": 1, "maxLength": 2000},
    "highlights": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "original": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.html$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 3000},
          "accessed_at": {"type": "string", "format": "date"}
        }
      }
    },
    "items": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 250},
          "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
          "metadata": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": ["string", "number"], "maxLength": 1000}}
        }
      }
    }
  },
  "anyOf": [{"required": ["original"]}, {"required": ["items"], "properties": {"items": {"minItems": 1}}}]
}
